# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillswap?retryWrites=true&w=majority

# Long random string used to sign JWTs - generate with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string

# How long an issued JWT stays valid
JWT_EXPIRES_IN=7d

# Port the Express server listens on (Render sets this automatically in production)
PORT=5000

# Path to the Firebase service account JSON (see README - only needed for FCM push + Google SSO verification)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
